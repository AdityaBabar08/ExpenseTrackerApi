{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=Localhost; Port=5432; Database=ExpenseTrackerDb; Username=AdminUser; Password=YourPasswordHere"
  },
  "Jwt": {
    "Key": "YourSecretKeyHere",
    "Issuer": "ExpenseTrackerApi",
    "Audience": "ExpenseTrackerApiUsers",
    "ExpireDays": 60
  }
}
